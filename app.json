{
  "expo": {
    "name": "stoQr",
    "slug": "stoqr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/stoqr-brand/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "stoqr",
    "splash": {
      "image": "./assets/stoqr-brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.didymus.stoqr",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/stoqr-brand/icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.didymus.stoqr"
    },
    "web": {
      "favicon": "./assets/stoqr-brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/stoqr-brand/icon.png",
          "color": "#4F46E5",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "notification": {
      "icon": "./assets/stoqr-brand/icon.png",
      "color": "#4F46E5"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01715ab4-e868-4678-aaaa-06dfe1205961"
      }
    },
    "owner": "didymus707"
  }
}
